.env
*.env
.DS_Store
__pycache__/
.venv/
# personal data (contacts from Clay) never goes in git — company-level data does (decision #24)
data/**/contacts*
data/**/*people*
!data/**/.gitkeep

# raw Clay exports contain people data (names, emails) — never commit (decision #43)
data/clay_exports/
# n8n local data / credentials
n8n/.n8n/
n8n/.cache/
