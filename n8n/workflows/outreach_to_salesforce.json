    {
      "id": "78a17fd6-ef3b-5b0a-ae52-0aab32d1d628",
      "name": "Query open automated Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.sfBase }}/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "SELECT Id, WhoId FROM Task WHERE Created_By_Automation__c = true AND IsClosed = false"
            }
          ]
        }
      },
      "credentials": {
