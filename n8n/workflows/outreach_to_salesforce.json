    },
    {
      "id": "0785d434-ff46-5227-891c-ea2d12c2eb42",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst plan = $('Plan').first().json;\nfunction res(node, sent) {\n  if (!sent.length) return { ok: 0, errors: [] };\n  const j = $(node).first().json, body = Array.isArray(j.body) ? j.body : [];\n  if (!body.length) return { ok: 0, errors: [{ status: j.statusCode, error: JSON.stringify(j.body).slice(0, 400) }] };\n  return { ok: body.filter(b => b.success).length, errors: body.filter(b => !b.success).map(b => JSON.stringify(b.errors).slice(0, 300)) };\n}\nconst contacts = res('Update Contacts', plan.updates), tasks = res('Create Tasks', plan.tasks);\nconst errors = contacts.errors.length + tasks.errors.length + plan.notFound.length;\nreturn [{ json: { runAt: $('Config').first().json.runAt, errors, contactsUpdated: contacts.ok, tasksCreated: tasks.ok,\n  tasksSkippedExisting: plan.skippedTasks, contactsNotFound: plan.notFound, contactErrors: contacts.errors, taskErrors: tasks.errors } }];\n"
      },
      "executeOnce": true
    },
    {
      "id": "eaf82afa-9d86-5c4e-b57e-0c7bd61254eb",
      "name": "Archive file",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "command": "={{ $json.errors === 0 ? `mkdir -p \"${$('Config').first().json.processed}/${$json.runAt.replace(/[:.]/g, '-')}\" && mv \"${$('Config').first().json.inbox}\"/claude_outreach_*.json \"${$('Config').first().json.processed}/${$json.runAt.replace(/[:.]/g, '-')}/\" && echo archived` : 'echo \"errors found: file left in inbox\"' }}"
      },
      "executeOnce": true
    }
