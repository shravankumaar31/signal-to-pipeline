            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ allOrNone: false, records: $('Plan').first().json.updates }) }}"
      },
      "credentials": {
        "oAuth2Api": {
          "id": "ol4NeAZvoDuiCyN2",
          "name": "Salesforce signal-dev (PKCE)"
        }
      },
