    {
      "id": "077af487-fb9d-5bf5-b09b-ea40387cab65",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst contacts = Object.fromEntries(($('Query Contacts').first().json.records || []).map(r => [String(r.Email_Key__c).toLowerCase(), r]));\nconst openTaskFor = new Set(($input.first().json.records || []).map(r => r.WhoId));\nconst records = $('Extract outreach').all().flatMap(i => (i.json.data && i.json.data.records) || []);\nconst updates = [], tasks = [], notFound = [], skippedTasks = [];\nfor (const rec of records) {\n  const c = contacts[String(rec.key).toLowerCase()];\n  if (!c) { notFound.push(rec.domain); continue; }\n  const u = { attributes: { type: 'Contact' }, Id: c.Id, Why_Now_Rationale__c: String(rec.why_now).slice(0, 2000) };\n  // Outreach status is workflow-owned: only move Not Started -> Drafted when an email draft exists\n  if (rec.channel === 'Email' && rec.gmail_draft_id && (!c.Outreach_Status__c || c.Outreach_Status__c === 'Not Started')) u.Outreach_Status__c = 'Drafted';\n  updates.push(u);\n  if (openTaskFor.has(c.Id)) { skippedTasks.push(rec.domain); continue; }\n  tasks.push(Object.assign({ attributes: { type: 'Task' }, WhoId: c.Id, WhatId: c.AccountId }, rec.task));\n}\nreturn [{ json: { updates, tasks, notFound, skippedTasks } }];\n"
      },
      "executeOnce": true
    },
    {
      "id": "90368d90-cea9-5ab7-8b83-38c168840a5d",
      "name": "Update Contacts",
      "type": "n8n-nodes-base.httpRequest",
